# Supabase project URL and keys — find these in:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never expose to the browser / never prefix
# with NEXT_PUBLIC. Used by server actions to write to the database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: salt for hashing voter IPs (defaults to an empty string if unset).
IP_HASH_SALT=change-me-to-a-random-string
